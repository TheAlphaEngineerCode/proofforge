{
  "name": "@proofforge/api",
  "version": "0.1.0",
  "description": "ProofForge REST API (Fastify).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@proofforge/agents": "workspace:*",
    "@proofforge/ai-providers": "workspace:*",
    "@proofforge/database": "workspace:*",
    "@proofforge/evidence-spec": "workspace:*",
    "@proofforge/github": "workspace:*",
    "@proofforge/observability": "workspace:*",
    "@proofforge/policy-engine": "workspace:*",
    "@proofforge/queue": "workspace:*",
    "@proofforge/shared-types": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@proofforge/test-fixtures": "workspace:*",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
