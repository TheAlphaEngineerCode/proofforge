# ─────────────────────────────────────────────────────────────
# ProofForge — example environment. Copy to .env and adjust.
# NEVER commit a real .env. No production secrets in this file.
# ─────────────────────────────────────────────────────────────

# Node
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Web
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=proofforge
POSTGRES_PASSWORD=proofforge
POSTGRES_DB=proofforge
DATABASE_URL=postgresql://proofforge:proofforge@localhost:5432/proofforge

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (MinIO in dev, S3-compatible in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proofforge-evidence
S3_ACCESS_KEY=proofforge
S3_SECRET_KEY=proofforge-secret

# GitHub App — integration stays disabled while unset; the webhook endpoint
# returns 503 without GITHUB_WEBHOOK_SECRET. See docs/github-app.md.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# The same App's OAuth credentials, which sign users in. Without them the
# dashboard has no GitHub login — and in production, no login at all, since
# dev-login is forced off there. Callback URL on the App must be
# <API_BASE_URL>/api/v1/auth/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Signs the OAuth `state`. Generated per process when unset, which is fine for
# one local process and wrong for two replicas — required in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_STATE_SECRET=

# AI providers (Phase 7 — provider-agnostic layer)
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Evidence signing (ed25519). Leave empty to produce unsigned manifests.
PROOFFORGE_SIGNING_PRIVATE_KEY=
PROOFFORGE_SIGNING_PUBLIC_KEY_ID=

# The images a repository's tests run inside. Defaults point at the ones this
# repository publishes; set these to run from a mirror or a registry of your
# own. See docs/sandbox-images.md.
PROOFFORGE_SANDBOX_PYTHON_IMAGE=
PROOFFORGE_SANDBOX_NODE_IMAGE=
